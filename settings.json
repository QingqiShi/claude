{
  "cleanupPeriodDays": 365,
  "env": {},
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "ask": [],
    "defaultMode": "auto",
    "additionalDirectories": [
      "~/.claude"
    ]
  },
  "model": "fable[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude UserPromptSubmit; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/deny-cross-repo-references.py"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/require-agent-model.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude Stop; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude StopFailure; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude SessionEnd; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude Notification; fi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh",
    "padding": 0,
    "refreshInterval": 5
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "feedbackDrafts": "off",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Pouncing",
      "Prowling",
      "Purring",
      "Kneading",
      "Napping",
      "Loafing",
      "Stretching",
      "Grooming",
      "Stalking",
      "Slinking",
      "Batting",
      "Chasing",
      "Scratching",
      "Meowing",
      "Chirping",
      "Blepping",
      "Zooming",
      "Perching",
      "Lurking",
      "Sniffing",
      "Snoozing",
      "Sunbathing",
      "Headbutting",
      "Skulking",
      "Yowling",
      "Curling up",
      "Sitting in the box",
      "Knocking things over",
      "Ignoring you",
      "Judging you",
      "Demanding snacks",
      "Hogging the keyboard"
    ]
  },
  "effortLevel": "xhigh",
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "preferredNotifChannel": "ghostty",
  "autoCompactEnabled": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "hard_deny": [
      "$defaults",
      "Cross-Repository Reference: Text sent to GitHub — a PR or issue body, a comment, a review, a commit message, release notes — that links to or names (owner/repo#number) an issue, pull request, or discussion in another repository. GitHub records a permanent \"mentioned this\" event on that item, which shows everyone there a link back to this project, and deleting the source does not remove it. The user never wants that link, so no instruction clears this rule. The sending tool and the text's origin do not matter. Text copied from another PR or a bot comment counts. Describing the upstream item in words — its title, its state, what it says — is fine, as is a reference to the repository the text lands in, a reference inside file content, or a read-only lookup of the foreign item."
    ],
    "environment": [
      "$defaults",
      "**Repository visibility**: public. Every repository I work in is public, so a commit or push anywhere publishes to the internet. Treat a repository as private only when the transcript shows it."
    ]
  },
  "voiceEnabled": true
}
